{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.capstone.structsim",
  "build": {
    "beforeDevCommand": "npx cross-env BROWSER=none npm run start --prefix ../../react-ui-temp",
    "beforeBuildCommand": "npm run build --prefix ../../react-ui-temp",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../react-ui-temp/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tauri-app",
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
