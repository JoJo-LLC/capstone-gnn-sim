{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Structural Response Simulator",
  "version": "0.1.0",
  "identifier": "com.SRS.G19",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Structural Response Simulator",
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
    "docker-compose.cpu.yml",
    "docker-compose.gpu.yml",
    "backend"
    ]
  }
}